# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini / Google GenAI (https://aistudio.google.com/apikey)
# AI_PROVIDER=mock works with no key, for UI dev without API cost.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google Cloud OAuth client (Forms API). Leave blank to disable Google Forms
# export -- the app still works, saving tests locally.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Shared secret for the Forms-bound Apps Script score webhook.
# Generate a unique value and store the same value in Apps Script properties.
GOOGLE_FORMS_WEBHOOK_SECRET=

# Base URL of this app, used to build the OAuth redirect and links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: ordered Gemini fallback chain for generation (comma-separated model names).
# Default: gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3-flash-preview
GEMINI_MODEL_CHAIN=
