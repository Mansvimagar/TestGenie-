# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini / Google GenAI (https://aistudio.google.com/apikey)
# AI_PROVIDER=mock works with no key, for UI dev without API cost.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google Cloud OAuth client (Forms API). Leave blank to disable Google Forms
# export -- the app still works, saving tests locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Base URL of this app, used to build the OAuth redirect and links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
